DEBUG=False
SECRET_KEY=django-insecure-ryuclass-super-secret-key-nextjs-django-rebuild
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ryuclass_db
DB_USER=root
DB_PASS=your_db_password

# AES Keys for video decryption
AES_KEY=RyusoSense2026SecretKeyAES256K
AES_IV=RyusoSenseIV2026

# Groq API
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# EasySlip API
EASYSLIP_API_KEY=your_easyslip_api_key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=AraigoguBot
TELEGRAM_ADMIN_CHAT_ID=your_chat_ids

# Hostinger Email SMTP Settings
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=support@chatbotth.me
EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL="RyuClass <support@chatbotth.me>"
